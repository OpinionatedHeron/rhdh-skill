#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.9"
# dependencies = ["rhdh-common"]
#
# [tool.uv.sources]
# rhdh-common = { git = "https://github.com/redhat-developer/rhdh-skill", subdirectory = "packages/rhdh-common" }
# ///
"""Thin wrapper to run rhdh-local CLI.

The rhdh_local package lives beside this script in the skill directory; uv
supplies the shared rhdh_common runtime, which is not part of a copied skill
directory.
"""

import sys
from pathlib import Path

# Add the skill directory to the path (where rhdh_local package lives)
skill_dir = Path(__file__).parent.parent
sys.path.insert(0, str(skill_dir))

from rhdh_local.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
